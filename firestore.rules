rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUserProfile() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'uid', 'email', 'name', 'goal', 'xp', 'workoutXp', 'challengeXp',
          'logs', 'challenges', 'savedWorkouts', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'email', 'name', 'goal', 'xp', 'workoutXp', 'challengeXp',
          'logs', 'challenges', 'savedWorkouts', 'createdAt', 'updatedAt'
        ])
        && d.email is string
        && d.email.size() <= 320
        && d.name is string
        && d.name.size() >= 1
        && d.name.size() <= 24
        && d.goal is string
        && d.goal.size() <= 60
        && d.xp is int
        && d.xp >= 0
        && d.xp <= 10000000
        && d.workoutXp is int
        && d.workoutXp >= 0
        && d.workoutXp <= 10000000
        && d.challengeXp is int
        && d.challengeXp >= 0
        && d.challengeXp <= 10000000
        && d.logs is list
        && d.logs.size() <= 500
        && d.challenges is list
        && d.challenges.size() <= 100
        && d.savedWorkouts is list
        && d.savedWorkouts.size() <= 100
        && d.createdAt is string
        && d.createdAt.size() <= 40
        && d.updatedAt is string
        && d.updatedAt.size() <= 40
        && (!('uid' in d) || (d.uid is string && d.uid == request.auth.uid));
    }

    // Every user's profile and progress is private to that authenticated account.
    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validUserProfile();
      allow delete: if signedInAs(uid);
    }

    // Deny all access to any collection not explicitly opened above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
